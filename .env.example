# DuckDNS에서 만든 도메인 (예: ob-crash.duckdns.org). Caddy 인증서 발급과 WebSocket Origin 검사에 쓰인다.
# 로컬 테스트는 localhost (자체 서명 인증서).
DOMAIN=your-game.duckdns.org

# 동시 접속 상한 (선택). 행사·교실처럼 한 Wi-Fi에서 여러 판을 돌리는 기준 기본값.
# WS_MAX_CONN_PER_IP=60
# WS_MAX_CONN_TOTAL=300

# SQLite 저장 위치 (선택, 기본 ./data)
# DATA_DIR=./data
